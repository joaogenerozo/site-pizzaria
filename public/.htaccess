# Hostinger (Apache/LiteSpeed): HTTPS, cabeçalhos de segurança e cache.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Força HTTPS (ative o SSL do domínio no hPanel antes)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # /admin sem barra -> /admin/
  RewriteRule ^admin$ admin/ [L,R=301]
  # Um endereço só para a página inicial (SEO): /index.html -> /
  # (THE_REQUEST: só o que o visitante pediu, não o index.html interno do DirectoryIndex)
  RewriteCond %{THE_REQUEST} \s[^\s?]*/index\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} ^(.*/)index\.html$ [NC]
  RewriteRule ^ %1 [L,R=301]
</IfModule>

# Compressão do texto (HTML, CSS, JS, JSON, SVG, XML): páginas chegam mais rápido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Só permite scripts e fontes do próprio site; dados só do Supabase. Imagens: qualquer https.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # HTML sempre atualizado; arquivos com hash podem ficar em cache por 1 ano
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|png|jpg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Arquivos sem hash no nome: cache curto, para uma troca aparecer em até 1 dia
  <FilesMatch "^(favicon\.(svg|png)|apple-touch-icon\.png|og-image\.png|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Nunca servir arquivos de configuração caso sejam enviados por engano
<FilesMatch "^\.env|\.(sql|md|map)$">
  Require all denied
</FilesMatch>
